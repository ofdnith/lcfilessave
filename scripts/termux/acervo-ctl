#!/data/data/com.termux/files/usr/bin/bash
# Controle do Acervo no Realme.
#   acervo-ctl start | stop | restart | status | logs
#   acervo-ctl senha | token NOME | cidades | verificar | atualizar
#   acervo-ctl duckdns [--mostrar | --remover]   endereço seguro (sem certificado para instalar)
set -uo pipefail

REPO="$HOME/acervo"
DATA="$HOME/acervo-dados"
CONF="$REPO/acervo.toml"
ACERVO="$REPO/server/.venv/bin/acervo --config $CONF"
PIDFILE="$DATA/supervisor.pid"
LOG="$DATA/logs/servidor.log"
HEALTH="$(mktemp)"   # Termux has no /tmp; mktemp uses $TMPDIR
trap 'rm -f "$HEALTH"' EXIT

running() { [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; }

case "${1:-status}" in
  start)
    if running; then echo "Já está rodando."; exit 0; fi
    termux-wake-lock 2>/dev/null || true
    mkdir -p "$DATA/logs"
    nohup bash "$REPO/scripts/termux/supervisor.sh" >/dev/null 2>&1 &
    echo $! > "$PIDFILE"
    echo "Acervo iniciado."
    ;;
  stop)
    if running; then
      pid="$(cat "$PIDFILE")"
      kill "$pid" 2>/dev/null
      pkill -TERM -f "acervo --config $CONF serve" 2>/dev/null
      rm -f "$PIDFILE"
      echo "Acervo parado."
    else
      echo "Não estava rodando."
    fi
    termux-wake-unlock 2>/dev/null || true
    ;;
  restart) "$0" stop; sleep 2; "$0" start ;;
  status)
    if running; then echo "Supervisor: rodando (pid $(cat "$PIDFILE"))"; else echo "Supervisor: parado"; fi
    proto=http; grep -q '^https = true' "$CONF" 2>/dev/null && proto=https
    if curl -ksf "$proto://127.0.0.1:8765/api/health" -o "$HEALTH" 2>/dev/null; then
      python - "$HEALTH" <<'EOF'
import json, sys
h = json.load(open(sys.argv[1]))
s = h["storage"]
print(f"Servidor: {'OK' if h['status'] == 'ok' else 'COM PROBLEMA'} · versão {h['version']}")
print(f"Disco: {s['free_bytes']/1e9:.1f} GB livres de {s['total_bytes']/1e9:.0f} GB ({s['used_pct']}% usado)")
if s.get("inbox_max_bytes"):
    print(f"Entrada: {s['inbox_bytes']/1e9:.1f} de {s['inbox_max_bytes']/1e9:.0f} GB")
r = s.get("inbox_reminder")
if r:
    print(f"  ! faça a triagem: {r['bytes']/1e9:.1f} GB esperando" + (f", o mais antigo há {r['days']} dias" if r["days"] else ""))
card = s.get("card")
if card and card["library_bytes"]:
    where = "voltando sozinho para a memória interna" if card["present"] else "COLOQUE O CARTÃO DE VOLTA"
    print(f"Cartão microSD antigo: {card['library_bytes']/1e9:.1f} GB do Acervo ainda nele ({where})")
t = h.get("thermal")
if t and t.get("temperature") is not None:
    print(f"Bateria: {t['temperature']:.1f} °C" + (" · tarefas PAUSADAS até esfriar" if t["paused"] else ""))
print("Ferramentas: " + ", ".join(f"{k} {'✓' if v else '✗'}" for k, v in h["tools"].items()))
for p in h["problems"]:
    print("  ! " + p)
EOF
    else
      echo "Servidor: não responde"
    fi
    $ACERVO config 2>/dev/null | grep -i -E "impressão|endereço seguro" || true
    ;;
  logs) tail -n 80 -f "$LOG" ;;
  senha) $ACERVO senha && echo "Reinicie com: acervo-ctl restart" ;;
  token) $ACERVO token criar "${2:-iPhone}" ;;   # para migrar: acervo-ctl token migracao
  cidades) $ACERVO baixar-cidades ;;
  duckdns) $ACERVO duckdns "${@:2}" ;;
  verificar) "$0" stop; $ACERVO verificar; "$0" start ;;
  atualizar)
    # Stop first: the update adjusts the catalog, and only a fresh start loads the new code.
    "$0" stop
    if ! (cd "$REPO" && git pull --ff-only && bash "$REPO/scripts/termux/instalar.sh"); then
      echo "A atualização não terminou (veja a mensagem acima). Religando o Acervo." >&2
    fi
    # Never leave the backups stopped, whatever happened above.
    running || "$0" start
    ;;
  *) sed -n '2,5p' "$0"; exit 2 ;;
esac
