#!/usr/bin/env bash
# Controle do Acervo no mini PC (Linux com systemd).
#   acervo-ctl status | start | stop | restart | logs
#   acervo-ctl senha | token NOME | cidades | verificar | atualizar
set -uo pipefail

REPO="$(dirname "$(dirname "$(readlink -f "$(command -v acervo-ctl)")")")"
[[ -f "$REPO/acervo.toml" ]] || REPO="$HOME/acervo"
CONF="$REPO/acervo.toml"
ACERVO="$REPO/server/.venv/bin/acervo --config $CONF"

case "${1:-status}" in
  start|stop|restart) sudo systemctl "$1" acervo && echo "acervo: $1 ok" ;;
  status)
    systemctl is-active --quiet acervo && echo "Serviço: rodando" || echo "Serviço: parado"
    if curl -ksf https://127.0.0.1:8765/api/health -o /tmp/acervo-health.json 2>/dev/null \
       || curl -sf http://127.0.0.1:8765/api/health -o /tmp/acervo-health.json 2>/dev/null; then
      python3 - <<'EOF'
import json
h = json.load(open("/tmp/acervo-health.json"))
s = h["storage"]
print(f"Servidor: {'OK' if h['status'] == 'ok' else 'COM PROBLEMA'} · versão {h['version']}")
print(f"Disco: {s['free_bytes']/1e9:.1f} GB livres de {s['total_bytes']/1e9:.0f} GB ({s['used_pct']}% usado)")
print("Ferramentas: " + ", ".join(f"{k} {'✓' if v else '✗'}" for k, v in h["tools"].items()))
if h.get("migration", {}).get("active"):
    print("MIGRAÇÃO EM ANDAMENTO: este servidor está só para consulta")
for p in h["problems"]:
    print("  ! " + p)
EOF
    else
      echo "Servidor: não responde"
    fi
    $ACERVO config 2>/dev/null | grep -i "impressão" || true
    ;;
  logs) journalctl -u acervo -n 80 -f ;;
  senha) $ACERVO senha && sudo systemctl restart acervo ;;
  token) $ACERVO token criar "${2:-iPhone}" ;;
  cidades) $ACERVO baixar-cidades ;;
  verificar) sudo systemctl stop acervo; $ACERVO verificar; sudo systemctl start acervo ;;
  atualizar) cd "$REPO" && git pull --ff-only && bash "$REPO/scripts/linux/instalar.sh" --atualizar ;;
  *) sed -n '2,4p' "$0"; exit 2 ;;
esac
